# Railway.app environment variables for JavaNext deployment

# Spring Boot Configuration
SPRING_PROFILES_ACTIVE=production
SPRING_APPLICATION_NAME=javanext

# Database - Railway provides these automatically
SPRING_DATASOURCE_URL=jdbc:postgresql://${{PGHOST}}:${{PGPORT}}/${{PGDATABASE}}
SPRING_DATASOURCE_USERNAME=${{PGUSER}}
SPRING_DATASOURCE_PASSWORD=${{PGPASSWORD}}
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# Kafka - Update with your Kafka connection details
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
SPRING_KAFKA_PRODUCER_ACKS=all
SPRING_KAFKA_PRODUCER_RETRIES=3
SPRING_KAFKA_CONSUMER_GROUP_ID=javanext-consumer-group
SPRING_KAFKA_CONSUMER_AUTO_OFFSET_RESET=earliest

# Application Settings
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/
SERVER_COMPRESSION_ENABLED=true
SERVER_COMPRESSION_MIN_RESPONSE_SIZE=1024

# JVM Options
JAVA_OPTS=-Xmx512m -Xms256m -XX:+UseG1GC -XX:MaxGCPauseMillis=200

# Actuator & Monitoring
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=when-authorized
MANAGEMENT_METRICS_EXPORT_PROMETHEUS_ENABLED=true

# Logging
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_JAVANEXT=DEBUG
LOGGING_PATTERN_CONSOLE=%d{yyyy-MM-dd HH:mm:ss} - %msg%n
